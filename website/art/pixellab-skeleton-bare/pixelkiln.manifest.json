{
  "$schema": "../../../schema/manifest.schema.json",
  "name": "pixelkiln-website-skeleton-bare",
  "styles": {
    "rig": { "generator": "map", "outDir": "out", "view": "low top-down", "noBackground": true }
  },
  "assets": {
    "base": { "prompt": "bare paperdoll base", "width": 64, "height": 64, "source": "base-south.png", "styles": ["rig"] },
    "base-wave": {
      "prompt": "wave",
      "styles": ["rig"],
      "revision": {
        "mode": "animate-skeleton",
