{
  "$schema": "https://doorman.griffen.codes/schema.json",
  "firewallEnabled": true,
  "rules": [
    {
      "id": "rule_log_cn_hk_sg_traffic_pVeorW",
      "name": "Challenge CN/HK/SG traffic",
      "description": "One headless-Chrome client on Tencent/Huawei cloud IPs swept the docs (6.0k of 6.2k logged hits, week to Nov 7). Challenge, not deny, in case real devs use VPNs. If it passes, deny on ASN/JA4.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "geo_country",
              "op": "inc",
              "value": [
                "CN",
                "HK",
                "SG"
              ]
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "challenge"
        }
      }
    },
    {
      "id": "rule_log_aocr_org_referrer_VRIGU1",
      "name": "Log aocr.org referrer",
      "description": "aocr.org (a radiology college) showed 20 visitors/20 views in Oct 2026, matching a crawler sweep, so the referrer is likely spoofed. Log-only to see what it hits.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "header",
              "key": "referer",
              "op": "sub",
              "value": "aocr.org"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "log"
        }
      }
    }
  ],
  "ips": [],
  "projectId": "prj_DlO0p7e58gwEHhC2TizJGHdt2Qzc",
  "teamId": "team_3fFGpm53GtnbGGSzpHhWxBKe",
  "version": 6,
  "updatedAt": "2026-11-07T15:20:09.261Z"
}