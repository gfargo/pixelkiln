{
  "$schema": "https://doorman.griffen.codes/schema.json",
  "firewallEnabled": true,
  "rules": [
    {
      "id": "rule_log_cn_hk_sg_traffic_pVeorW",
      "name": "Log CN/HK/SG traffic",
      "description": "~85% of Oct 2026 visitors were crawler-like traffic from China, hitting single docs pages once. Log-only for a week to see volume; then switch action to challenge.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "geo_country",
              "op": "inc",
              "value": [
                "CN",
                "HK",
                "SG"
              ]
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "log"
        }
      }
    },
    {
      "id": "rule_log_aocr_org_referrer_VRIGU1",
      "name": "Log aocr.org referrer",
      "description": "aocr.org (a radiology college) showed 20 visitors/20 views in Oct 2026, matching a crawler sweep, so the referrer is likely spoofed. Log-only to see what it hits.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "header",
              "key": "referer",
              "op": "sub",
              "value": "aocr.org"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "log"
        }
      }
    }
  ],
  "ips": [],
  "projectId": "prj_DlO0p7e58gwEHhC2TizJGHdt2Qzc",
  "teamId": "team_3fFGpm53GtnbGGSzpHhWxBKe",
  "version": 3,
  "updatedAt": "2026-11-01T17:25:39.280Z"
}