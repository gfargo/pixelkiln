{
  "name": "pixelkiln",
  "version": "0.1.0",
  "description": "Manifest-driven bulk pixel art generation against the PixelLab API. No LLM in the loop.",
  "type": "module",
  "bin": {
    "pixelkiln": "./bin/pixelkiln.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "pixelkiln": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "private": true,
  "license": "MIT",
  "keywords": [
    "pixel-art",
    "sprites",
    "game-assets",
    "pixellab",
    "asset-pipeline",
    "generative",
    "lockfile",
    "cli"
  ],
  "files": [
    "src",
    "bin",
    "schema",
    "README.md",
    "LICENSE"
  ]
}
