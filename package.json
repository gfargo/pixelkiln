{
  "name": "pixelkiln",
  "version": "0.19.0",
  "description": "Manifest-driven pixel-art generation, review, recovery, and packaging with deterministic provenance.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pixelkiln": "bin/pixelkiln.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "pixelkiln": "tsx src/cli.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap && tsup src/cli.ts --format esm --dts --sourcemap",
    "prepack": "npm run build",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docs": "node scripts/check-docs.mjs",
    "test:release": "node scripts/check-release.mjs",
    "test:security": "tsx scripts/check-source-url-hygiene.ts",
    "test:quality": "tsx src/cli.ts quality check --from benchmarks/provider-hires/comfyui/pixelkiln.quality-baseline.json",
    "test:package": "node scripts/smoke-package.mjs",
    "test:watch": "vitest",
    "schema": "tsx scripts/gen-schema.ts",
    "website:dev": "npm run dev --prefix website",
    "website:check": "npm run check:content --prefix website",
    "website:lint": "npm run lint --prefix website",
    "website:build": "npm run build --prefix website"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfargo/pixelkiln.git"
  },
  "bugs": {
    "url": "https://github.com/gfargo/pixelkiln/issues"
  },
  "homepage": "https://pixelkiln.griffen.codes",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.10.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "keywords": [
    "pixel-art",
    "sprites",
    "game-assets",
    "pixellab",
    "retro-diffusion",
    "comfyui",
    "scenario",
    "image-generation",
    "asset-pipeline",
    "generative",
    "lockfile",
    "cli"
  ],
  "files": [
    "dist",
    "bin",
    "schema",
    "recipes",
    "skills",
    "docs",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PROVIDERS.md",
    "NAMING.md",
    "LICENSE"
  ]
}
