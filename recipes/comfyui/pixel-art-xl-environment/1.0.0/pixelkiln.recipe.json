  "schemaVersion": 1,
  "id": "comfyui/pixel-art-xl-environment",
  "version": "1.0.0",
  "provider": "comfyui",
  "summary": "SDXL and Pixel Art XL composition source for scenic game environments.",
  "files": [
    {
      "path": "workflow-api.json",
      "role": "workflow",
      "sha256": "4cea2c6cfd35411ae4a6b526721b269c71df6efed427da08ee6a60cb513c07e4"
    }
  ],
  "models": [
    {
      "path": "checkpoints/sd_xl_base_1.0.safetensors",
      "sha256": "31e35c80fc4829d14f90153f4c74cd59c90b779f6afe05a74cd6120b893f7e5b",
      "source": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/blob/main/sd_xl_base_1.0.safetensors",
      "license": "CreativeML Open RAIL++-M"
    },
    {
      "path": "loras/pixel-art-xl.safetensors",
      "sha256": "4234637cb80c998f41e348e6a6cb6bc20d8d038b2b0f256b6129b3b5e353eef7",
      "source": "https://huggingface.co/nerijs/pixel-art-xl/blob/main/pixel-art-xl.safetensors",
      "license": "CreativeML OpenRAIL-M"
    }
  ],
  "styleId": "comfyui-environment",
  "style": {
    "generator": "map",
    "outDir": "art/generated/comfyui-environment",
    "seed": 31415,
    "noBackground": false,
    "promptPrefix": "pixel art, polished 16-bit game environment, crisp clusters, layered depth",
    "promptSuffix": "full-bleed scenic composition, no frame",
    "providerOptions": {
      "comfyui": {
        "workflowFile": "{{recipeDir}}/workflow-api.json",
        "outputNodeId": "9",
        "numImages": 4,
        "bindings": {
          "prompt": { "nodeId": "6", "input": "text" },
          "width": { "nodeId": "11", "input": "width" },
          "height": { "nodeId": "11", "input": "height" },
          "batchSize": { "nodeId": "5", "input": "batch_size" },
          "seed": { "nodeId": "3", "input": "seed" }
        }
      }
    }
  },
  "workflow": {
    "path": "workflow-api.json",
    "outputNodeId": "9",
    "numImages": 4,
    "bindings": {
      "prompt": { "nodeId": "6", "input": "text" },
      "width": { "nodeId": "11", "input": "width" },
      "height": { "nodeId": "11", "input": "height" },
      "batchSize": { "nodeId": "5", "input": "batch_size" },
      "seed": { "nodeId": "3", "input": "seed" }
    }
  },
  "quality": {
    "stage": "composition-source",
    "workingCanvas": { "width": 1024, "height": 1024 },
    "recommendedNativeSize": { "min": 48, "max": 128 },
    "paletteColors": { "min": 16, "max": 32 },
    "background": "full-bleed",
    "checks": ["prompt-coverage", "native-grid", "final-palette", "human-1x"],
    "notes": [
      "Reject missing subjects or weak composition before refinement.",
      "The saved PNG is source material, not finished pixel art.",
      "Do not add a latent upscale or second sampling pass by default."
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "digest": "764d4211d6d502b4a6395a09f2c4731fbd02d8194d3c1fccf52da173459b3eed"
  }
