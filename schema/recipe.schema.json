                    "input": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "nodeId",
                    "input"
                  ],
                  "additionalProperties": false
                },
                "batchSize": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "nodeId",
                    "input"
                  ],
                  "additionalProperties": false
                },
                "seed": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input": {
                      "type": "string",
                      "minLength": 1
                    }
