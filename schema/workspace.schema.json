{
  "$ref": "#/definitions/PixelkilnWorkspace",
  "definitions": {
    "PixelkilnWorkspace": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "manifest": {
                "type": "string",
                "minLength": 1
              },
              "lock": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "default": "pixellab"
              },
              "account": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "manifest",
              "lock"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
