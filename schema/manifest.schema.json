{
  "$ref": "#/definitions/PixelkilnManifest",
  "definitions": {
    "PixelkilnManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "default": "pixellab"
        },
        "history": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generator": {
                    "type": "string",
                    "enum": [
                      "1dir",
                      "map",
                      "pixflux",
                      "tiles",
                      "animation",
                      "frames",
                      "character"
                    ],
                    "default": "map"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 8192
                  },
                  "view": {
                    "type": "string"
                  },
                  "promptSuffix": {
                    "type": "string",
                    "default": ""
                  },
                  "promptPrefix": {
                    "type": "string",
                    "default": ""
                  },
                  "styleImages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    "default": []
                  },
                  "outDir": {
                    "type": "string"
                  },
                  "outline": {
                    "type": "string"
                  },
                  "shading": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "tileSize": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 256
                  },
                  "tileType": {
                    "type": "string",
                    "enum": [
                      "hex",
                      "hex_pointy",
                      "isometric",
                      "oblique",
                      "octagon",
                      "square_topdown"
                    ]
                  },
                  "tileView": {
                    "type": "string",
                    "enum": [
                      "top-down",
                      "high top-down",
                      "low top-down",
                      "side"
                    ]
                  },
                  "tileFeature": {
                    "type": "string",
                    "enum": [
                      "roads",
                      "tileset",
                      "building"
                    ]
                  },
                  "outlineMode": {
                    "type": "string",
                    "enum": [
                      "outline",
                      "segmentation"
                    ]
                  },
                  "noBackground": {
                    "type": "boolean",
                    "default": true
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "v3",
                      "pro"
                    ]
                  },
                  "directions": {
                    "type": "number",
                    "enum": [
                      4,
                      8
                    ]
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "palette": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^#?[0-9a-f]{6}$"
                    },
                    "default": []
                  },
                  "enforcePalette": {
                    "type": "boolean",
                    "default": false
                  },
                  "quality": {
                    "type": "object",
                    "properties": {
                      "outDir": {
                        "type": "string",
                        "minLength": 1
                      },
                      "palette": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^#?[0-9a-f]{6}$"
                        },
                        "minItems": 2,
                        "maxItems": 256
                      },
                      "minGridConfidence": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ],
                        "default": "high"
                      },
                      "minTransparency": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "fixerRevision": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fixerPython": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fps": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      }
                    },
                    "required": [
                      "outDir",
                      "palette"
                    ],
                    "additionalProperties": false
                  },
                  "mount": {
                    "type": "object",
                    "properties": {
                      "base": {
                        "type": "string"
                      },
                      "cellWidth": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "cellHeight": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "out": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "cellWidth",
                      "cellHeight",
                      "out"
                    ],
                    "additionalProperties": false
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "providerOptions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "default": {}
                  }
                },
                "required": [
                  "outDir"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generator": {
                    "type": "string",
                    "enum": [
                      "1dir",
                      "map",
                      "pixflux",
                      "tiles",
                      "animation",
                      "frames",
                      "character"
                    ],
                    "default": "map"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 8192
                  },
                  "view": {
                    "type": "string"
                  },
                  "promptSuffix": {
                    "type": "string",
                    "default": ""
                  },
                  "promptPrefix": {
                    "type": "string",
                    "default": ""
                  },
                  "styleImages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    "default": []
                  },
                  "outDir": {
                    "type": "string"
                  },
                  "outline": {
                    "type": "string"
                  },
                  "shading": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "tileSize": {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 256
                  },
                  "tileType": {
                    "type": "string",
                    "enum": [
                      "hex",
                      "hex_pointy",
                      "isometric",
                      "oblique",
                      "octagon",
                      "square_topdown"
                    ]
                  },
                  "tileView": {
                    "type": "string",
                    "enum": [
                      "top-down",
                      "high top-down",
                      "low top-down",
                      "side"
                    ]
                  },
                  "tileFeature": {
                    "type": "string",
                    "enum": [
                      "roads",
                      "tileset",
                      "building"
                    ]
                  },
                  "outlineMode": {
                    "type": "string",
                    "enum": [
                      "outline",
                      "segmentation"
                    ]
                  },
                  "noBackground": {
                    "type": "boolean",
                    "default": true
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "v3",
                      "pro"
                    ]
                  },
                  "directions": {
                    "type": "number",
                    "enum": [
                      4,
                      8
                    ]
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "palette": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^#?[0-9a-f]{6}$"
                    },
                    "default": []
                  },
                  "enforcePalette": {
                    "type": "boolean",
                    "default": false
                  },
                  "quality": {
                    "type": "object",
                    "properties": {
                      "outDir": {
                        "type": "string",
                        "minLength": 1
                      },
                      "palette": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^#?[0-9a-f]{6}$"
                        },
                        "minItems": 2,
                        "maxItems": 256
                      },
                      "minGridConfidence": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ],
                        "default": "high"
                      },
                      "minTransparency": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "fixerRevision": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fixerPython": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fps": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      }
                    },
                    "additionalProperties": false
                  },
                  "mount": {
                    "type": "object",
                    "properties": {
                      "base": {
                        "type": "string"
                      },
                      "cellWidth": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "cellHeight": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "out": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "cellWidth",
                      "cellHeight",
                      "out"
                    ],
                    "additionalProperties": false
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "providerOptions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "default": {}
                  },
                  "extends": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "outDir",
                  "extends"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 8192
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 8192
              },
              "size": {
                "type": "integer",
                "minimum": 32,
                "maximum": 256
              },
              "file": {
                "type": "string"
              },
              "cell": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "source": {
                "type": "string"
              },
              "sourceByStyle": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "default": {}
              },
              "revision": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "image-to-image",
                      "inpaint",
                      "outpaint"
                    ]
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mask": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "mode",
                  "from"
                ],
                "additionalProperties": false
              },
              "state": {
                "type": "object",
                "properties": {
                  "of": {
                    "type": "string",
                    "minLength": 1
                  },
                  "paletteFromReference": {
                    "type": "boolean",
                    "default": false
                  },
                  "canvas": {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 256
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 256
                      }
                    },
                    "required": [
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "of"
                ],
                "additionalProperties": false
              },
              "animation": {
                "type": "object",
                "properties": {
                  "of": {
                    "type": "string",
                    "minLength": 1
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "south",
                      "south-east",
                      "east",
                      "north-east",
                      "north",
                      "north-west",
                      "west",
                      "south-west"
                    ],
                    "default": "south"
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 16
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60,
                    "default": 8
                  },
                  "keepFirstFrame": {
                    "type": "boolean",
                    "default": true
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "template",
                      "v3",
                      "pro"
                    ]
                  }
                },
                "required": [
                  "of"
                ],
                "additionalProperties": false
              },
              "outputRole": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "promptByStyle": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "providerInputs": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "minItems": 2,
                      "maxItems": 64
                    }
                  ]
                },
                "default": {}
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "styles",
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
