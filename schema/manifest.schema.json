{
  "$ref": "#/definitions/PixelkilnManifest",
  "definitions": {
    "PixelkilnManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "generator": {
                "type": "string",
                "enum": [
                  "1dir",
                  "map",
                  "pixflux",
                  "tiles"
                ],
                "default": "map"
              },
              "size": {
                "type": "integer",
                "minimum": 32,
                "maximum": 256
              },
              "view": {
                "type": "string"
              },
              "promptSuffix": {
                "type": "string",
                "default": ""
              },
              "promptPrefix": {
                "type": "string",
                "default": ""
              },
              "styleImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "outDir": {
                "type": "string"
              },
              "outline": {
                "type": "string"
              },
              "shading": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "tileSize": {
                "type": "integer",
                "minimum": 16,
                "maximum": 256
              },
              "tileType": {
                "type": "string",
                "enum": [
                  "hex",
                  "hex_pointy",
                  "isometric",
                  "oblique",
                  "octagon",
                  "square_topdown"
                ]
              },
              "tileView": {
                "type": "string",
                "enum": [
                  "top-down",
                  "high top-down",
                  "low top-down",
                  "side"
                ]
              },
              "tileFeature": {
                "type": "string",
                "enum": [
                  "roads",
                  "tileset",
                  "building"
                ]
              },
              "outlineMode": {
                "type": "string",
                "enum": [
                  "outline",
                  "segmentation"
                ]
              },
              "seed": {
                "type": "integer"
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "mount": {
                "type": "object",
                "properties": {
                  "base": {
                    "type": "string"
                  },
                  "cellWidth": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "cellHeight": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "out": {
                    "type": "string"
                  }
                },
                "required": [
                  "cellWidth",
                  "cellHeight",
                  "out"
                ],
                "additionalProperties": false
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "outDir"
            ],
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 400
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 400
              },
              "size": {
                "type": "integer",
                "minimum": 32,
                "maximum": 256
              },
              "file": {
                "type": "string"
              },
              "cell": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "promptByStyle": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "styles",
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
